# Optional - for enhanced features
USDA_API_KEY=your_usda_key_here

# LangSmith
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=guzzlers-n-dragons
# Uncomment the following if you are on the EU instance
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Database
DATABASE_URL=sqlite:///data/ingredients.db

# Vector Store
CHROMA_PERSIST_DIR=data/chroma

# App
HOST=0.0.0.0
PORT=8000
DEBUG=false
SQL_ECHO=false
AGENT_TIMEOUT_SECONDS=300
# CORS: JSON array of allowed frontend origins for credentialed requests.
# Development: ["http://localhost:5173"]
# Production: replace with your real frontend URL(s), e.g. ["https://app.example.com"]
# Do NOT use ["*"] — browsers reject wildcard + credentials.
CORS_ORIGINS=["http://localhost:5173"]

# LLM
# OLLAMA_HOST=https://api.ollama.com
# OLLAMA_API_KEY=your_api_key
LLM_MODEL=gemma4:31b-cloud
LLM_TEMPERATURE=0.7

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5